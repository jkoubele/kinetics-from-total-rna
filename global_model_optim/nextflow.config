// Standalone config for the optimizer experiments. Deliberately not including the main pipeline's
// nextflow.config: that one carries withName selectors and a lineage block for a different set of
// processes, and none of it applies here.

params {
    data_dir        = "${projectDir}/data"
    // Each run creates its own results_NNN folder under output_root; run_name overrides the
    // auto-numbering when a run deserves a name of its own.
    output_root     = "${projectDir}"
    run_name        = null
    experiments     = 'experiment_001'
    model_types     = 'rna_kinetics,intron_coverage'

    // Subsetting. Leave null to use everything. For the intron_coverage model, num_introns wins;
    // if only num_genes is given, that many genes are sampled and all of their introns are kept.
    num_genes       = null
    num_introns     = null
    num_lrt_tests   = null
    seed            = 0
    verbose         = false

    container_python = 'jkoubele/rna-kinetics-python:0.2.0'
    fit_cpus         = 6
    fit_memory       = '16 GB'
}

// Docker is always on, so every fit shows up in `docker ps` and none of them can quietly run on the
// host instead. Both the experiment code and the rna_kinetics package live above projectDir and are
// reached through PYTHONPATH rather than being copied in, so the parent directory has to be bound.
docker {
    enabled = true
    runOptions = "-u \$(id -u):\$(id -g) -v ${projectDir}/..:${projectDir}/.."
}

profiles {
    beyer_cluster {
        process {
            executor = 'slurm'
        }
        params {
            // Same reasoning as the main pipeline: over-request memory so that only one fitting
            // process lands on a node, because co-located PyTorch processes collide.
            fit_cpus   = 25
            fit_memory = '130 GB'
        }
        docker {
            runOptions = "-u \$(id -u):\$(id -g) --group-add 1000 -v ${projectDir}/..:${projectDir}/.."
        }
    }
}

