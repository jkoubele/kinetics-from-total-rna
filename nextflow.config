params {
    outdir = "./results"
    reports_subdir = 'pipeline_info'
    run_name = null // Optional name of the modeling output subfolder; if null, a timestamp-based name is used
    // Output subfolder of a modeling run; the timestamp is fixed once per run, so all processes publish to the same folder
    model_run_id = params.run_name ?: "model_run_" + new Date().format("dd_MMM_yyyy_HH_mm_ss")

    container_tools = "jkoubele/rna-kinetics-tools:0.2.0"
    container_python = "jkoubele/rna-kinetics-python:0.2.0"
    container_r = "jkoubele/rna-kinetics-r:0.4.0"

    workDir = "./work"
    // Optional full-path override for lineage storage, default (if null) is in .lineage next to params.workDir
    lineage_dir = null

    genomic_features_dir = null // Optional path to pre-computed genomic features folder (output of ExtractGenomicFeatures).

    // Fit lfc_elong_over_splice from the intron coverage shape first and hold it fixed while
    // fitting the read counts. Defaulted here rather than left to the params file, so that a file
    // written before this existed still gets the recommended estimator.
    use_plug_in_coverage = true

    extract_genomic_features_cpus = 16
    extract_genomic_features_memory = '120 GB'

    build_star_index_cpus = 16
    build_star_index_memory = '200 GB'

    build_salmon_index_cpus = 16
    build_salmon_index_memory = '200 GB'

    star_align_cpus = 12
    star_align_memory = '120 GB'

    fit_rna_kinetics_model_cpus = 6 // We override for our cluster
    fit_rna_kinetics_model_memory  = '10 GB' // We override for our cluster

    fit_global_rna_kinetics_model_cpus = 15 // We override for our cluster
    fit_global_rna_kinetics_model_memory = '20 GB' // We override for our cluster

    fit_global_intron_coverage_model_cpus = 15 // We override for our cluster
    fit_global_intron_coverage_model_memory = '20 GB' // We override for our cluster

    fit_gene_specific_intron_coverage_model_cpus = 6 // We override for our cluster
    fit_gene_specific_intron_coverage_model_memory = '10 GB' // We override for our cluster

    fit_intron_specific_intron_coverage_model_cpus = 6 // We override for our cluster
    fit_intron_specific_intron_coverage_model_memory = '10 GB' // We override for our cluster

    estimate_prior_variance_memory = '32 GB' // We override for our cluster

}

workDir = params.workDir

report {
    enabled = true
    file = "${params.outdir}/${params.reports_subdir}/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/${params.reports_subdir}/timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/${params.reports_subdir}/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/${params.reports_subdir}/dag.png"
    overwrite = true
}

lineage {
    enabled = true
    store.location = {
        // If user set a custom full path, use that
        if (params.lineage_dir) {
            return params.lineage_dir
        }
        // Otherwise default to <dataset_root>/.lineage, where <dataset_root> is the parent of workDir
        if (!params.workDir) {
            // optional: fallback if workDir is not set
            return '.lineage'
        }
        def dataset_root = new File(params.workDir).getParent()
        return "${dataset_root}/.lineage"
    }()
}


process {

    withName: FastQC {
        container = "quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0"
        cpus = 2
        memory = '4 GB'
    }

    withName: MultiQC {
        container = "multiqc/multiqc:v1.30"
        cpus = 4
        memory = '8 GB'
    }

    withName: ExtractGenomicFeatures{
        container = params.container_r
        cpus = { params.extract_genomic_features_cpus }
        memory = { params.extract_genomic_features_memory }
    }

    withName: BuildStarIndex {
        container = params.container_tools
        cpus = { params.build_star_index_cpus }
        memory = { params.build_star_index_memory }
    }

    withName: BuildSalmonIndex {
        container = params.container_tools
        cpus = { params.build_salmon_index_cpus }
        memory = { params.build_salmon_index_memory }
    }

    withName: PrepareTx2Gene {
        container = params.container_r
        cpus = 2
        memory = '16 GB'
    }

    withName: CreateGenomeFastaIndex {
        container = params.container_tools
        cpus = 1
        memory = '4 GB'
    }

    withName: STARAlign {
        container = params.container_tools
        cpus = { params.star_align_cpus }
        memory = { params.star_align_memory }
    }

    withName: ExtractIntronicReads {
        container = params.container_python
        cpus = 4
        memory = '10 GB'
    }

    withName: RemoveIntronicReadsFromFASTQ{
        container = params.container_python
        cpus = 6
        memory = '12 GB'
    }

    withName: SalmonQuantification {
        container = params.container_tools
        cpus = 8
        memory = '20 GB'
    }

    withName: ComputeCoverage {
        container = params.container_tools
        cpus = 2
        memory = '8 GB'
    }

    withName: RescaleCoverage{
        container = params.container_r
        cpus = 2
        memory = '16 GB'
    }

    withName: AggregateReadCounts{
        container = params.container_r
        cpus = 2
        memory = '16 GB'
    }

    withName: IntronMetacoveragePlots{
        container = params.container_python
        cpus = 4
        memory = '8 GB'
    }

    withName: StratifiedIntronMetacoveragePlots{
        container = params.container_python
        cpus = 4
        memory = '8 GB'
    }

    withName: FindModelableGenes{
        container = params.container_r
        cpus = 2
        memory = '8 GB'
    }

    withName: WriteDesignMetadata{
        container = params.container_python
        cpus = 1
        memory = '2 GB'
    }

    withName: CreateDesignMatrices{
        container = params.container_r
        cpus = 1
        memory = '6 GB'
    }

    withName: GetModeledGenes{
        container = params.container_r
        cpus = 1
        memory = '6 GB'
    }

    withName: FitRNAKineticsModel {
        container = params.container_python
        cpus = { params.fit_rna_kinetics_model_cpus }
        memory = { params.fit_rna_kinetics_model_memory }
    }

    withName: FitRegularizedRNAKineticsModel {
        container = params.container_python
        cpus = { params.fit_rna_kinetics_model_cpus }
        memory = { params.fit_rna_kinetics_model_memory }
    }

    withName: FitGlobalRNAKineticsModel {
        container = params.container_python
        cpus = { params.fit_global_rna_kinetics_model_cpus }
        memory = { params.fit_global_rna_kinetics_model_memory }
    }

    withName: FitGlobalIntronCoverageModel {
        container = params.container_python
        cpus = { params.fit_global_intron_coverage_model_cpus }
        memory = { params.fit_global_intron_coverage_model_memory }
    }

    withName: FitGeneSpecificIntronCoverageModel {
        container = params.container_python
        cpus = { params.fit_gene_specific_intron_coverage_model_cpus }
        memory = { params.fit_gene_specific_intron_coverage_model_memory }
    }

    withName: FitIntronSpecificIntronCoverageModel {
        container = params.container_python
        cpus = { params.fit_intron_specific_intron_coverage_model_cpus }
        memory = { params.fit_intron_specific_intron_coverage_model_memory }
    }

    withName: MergeModelResultChunks{
        container = params.container_r
        cpus = 1
        memory = '8 GB'
    }

    // Loads every chunk's coverage fits at once to write the single artifact the plug-in reads,
    // so the memory is set by the whole dataset's fits rather than by one chunk's. An
    // intron-specific run is the large case, one fit per intron over the whole dataset.
    withName: MergePlugInCoverageFits {
        container = params.container_python
        cpus = 1
        memory = '16 GB'
    }

    // The mixmeta REML behind this process uses multithreaded BLAS, which is what the CPUs are
    // for. Only the memory is parametrized, being the one value a cluster may need to change.
    withName: EstimatePriorVariance {
        container = params.container_r
        cpus = 16
        memory = { params.estimate_prior_variance_memory }
    }

    withName: FitRegularizedIntronCoverageModel {
        container = params.container_python
        cpus = { params.fit_gene_specific_intron_coverage_model_cpus }
        memory = { params.fit_gene_specific_intron_coverage_model_memory }
    }

    withName: MergeRegularization {
        container = params.container_r
        cpus = 2
        memory = '6 GB'
    }

    withName: PostprocessResultsAndPlot {
        container = params.container_r
        cpus = 2
        memory = '6 GB'
    }

    withName: PostprocessGlobalResultsAndPlot {
        container = params.container_r
        cpus = 2
        memory = '6 GB'
    }

}

profiles {

    local {
        params {
            // Memory caps for a 64 GB / 20-core laptop.
            // Building STAR/Salmon index for human/mouse requires more RAM than available;
            // provide a pre-built index via star_index / salmon_index in your params file instead.
            // Small genomes (e.g. C. elegans) can be indexed within these limits.
            extract_genomic_features_cpus = 8
            extract_genomic_features_memory = '56 GB'
            build_star_index_memory = '56 GB'
            build_salmon_index_memory = '56 GB'
            star_align_memory = '56 GB'
        }
    }

    beyer_cluster {
        params{
           // Following values are hotfix for issue on our cluster, when running more than one FitRNAKineticsModel processes per node
           // causes their CPU usage somehow collide. We therefore use artificially high memory requirement to avoid
           // more than one process to be submitted on one node.
           fit_rna_kinetics_model_cpus = 25
           fit_rna_kinetics_model_memory = '130 GB'

           fit_global_rna_kinetics_model_cpus = 25
           fit_global_rna_kinetics_model_memory = '130 GB'

           fit_global_intron_coverage_model_cpus = 25
           fit_global_intron_coverage_model_memory = '130 GB'

           fit_gene_specific_intron_coverage_model_cpus = 25
           fit_gene_specific_intron_coverage_model_memory = '130 GB'

           fit_intron_specific_intron_coverage_model_cpus = 25
           fit_intron_specific_intron_coverage_model_memory = '130 GB'

           // Overallocated to steer placement, not because the fit needs it: even the
           // intron-specific variants, which feed mixmeta one unit per intron, peak well under
           // 2 GB. Co-locating this process with a model fit coincided with an illegal-instruction
           // crash in the PyTorch process sharing the node, which stopped once this request made
           // the two unschedulable together. The cause is not understood, so this is a workaround
           // of the same kind as the values above.
           estimate_prior_variance_memory = '130 GB'

        }
        process {
          executor = 'slurm'
        }

        // Same as the docker profile below, plus --group-add for our cluster
        docker {
            enabled = true
            runOptions = "-u \$(id -u):\$(id -g) --group-add 1000 -v ${projectDir}:${projectDir}"
        }
    }

    // Container engines: exactly one of these is required, unless using beyer_cluster (which enables Docker itself).
    //
    // All of them bind projectDir explicitly (-v for Docker, -B for Singularity/Apptainer), since the processes
    // import rna_kinetics from it via PYTHONPATH. Nextflow itself mounts only bin/ and the work directory, so
    // projectDir would otherwise be visible only when it happens to share a parent folder with them.
    docker {
        docker {
            enabled = true
            runOptions = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir}"
        }
    }

    // Converted images are cached in NXF_SINGULARITY_CACHEDIR (or NXF_APPTAINER_CACHEDIR); if unset, in <workDir>/singularity
    singularity {
        singularity {
            enabled = true
            autoMounts = true
            runOptions = "-B ${projectDir}"
            pullTimeout = '2h' // The R image is ~5 GB and conversion to SIF is slow
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
            runOptions = "-B ${projectDir}"
            pullTimeout = '2h'
        }
    }
}

